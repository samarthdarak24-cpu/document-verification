# DocuTrace backend configuration.
#
# Copy this file to `.env` and edit as needed. Every value below is optional:
# the defaults shown are what the application uses when the variable is unset.
#
# The application is fully local — no API keys, no cloud services.

# --- General ----------------------------------------------------------------
APP_NAME=DocuTrace
VERSION=1.0.0
DEBUG=false

# --- Database (SQLite only) -------------------------------------------------
# Relative paths are resolved from the repository root, not the CWD.
DATABASE_URL=sqlite:///./backend/docutrace.db

# --- Storage ----------------------------------------------------------------
# Uploaded documents and generated reports, relative to the repository root.
UPLOAD_DIR=backend/storage/documents
REPORT_DIR=backend/storage/reports

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=25
# Text comparison is bounded by this many tokens to keep DP quadratic cost sane.
DP_MAX_TOKENS=2000
TEXT_EXCERPT_CHARS=4000

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OCR --------------------------------------------------------------------
# Tesseract is a system dependency, not a Python package. When it is missing the
# extraction layer records a warning and reports scanned files as unreadable
# instead of failing the upload.
OCR_ENABLED=true
# A page with fewer than this many characters is considered "sparse" and is
# re-read with OCR when Tesseract is available.
OCR_MIN_CHARS_PER_PAGE=100
